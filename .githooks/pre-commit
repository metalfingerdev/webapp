#!/bin/sh
# Safety net for a public repo. Bypass only when you are sure: git commit --no-verify
# A line can opt out of the identifier checks with the comment `allow-identifier`.

branch=$(git symbolic-ref --short HEAD 2>/dev/null)
if [ "$branch" = "main" ] && [ -z "$ALLOW_MAIN_COMMIT" ]; then
  echo "pre-commit: don't commit on main; work on a step branch (git switch -c step-<n>-<name>)." >&2
  echo "            (ALLOW_MAIN_COMMIT=1 git commit ... to override)" >&2
  exit 1
fi

staged=$(git diff --cached --name-only --diff-filter=AM)
if printf '%s\n' "$staged" | grep -E '(^|/)\.env(\.[^/]*)?$' | grep -qvE '(^|/)\.env\.example$'; then
  echo "pre-commit: a .env file is staged; it holds secrets and must not be committed." >&2
  exit 1
fi

added=$(git diff --cached -U0 --diff-filter=AM -- . ':(exclude)pnpm-lock.yaml' ':(exclude).githooks/*' \
  | grep -E '^\+[^+]' | grep -v 'allow-identifier')

fail=0
check() {
  found=$(printf '%s\n' "$added" | grep -E "$1" | head -3)
  if [ -n "$found" ]; then
    echo "pre-commit: $2:" >&2
    printf '%s\n' "$found" | cut -c1-160 >&2
    fail=1
  fi
}

check '(^|[^0-9A-Za-z])(\+91[ -]?)?[6-9][0-9]{4}[ -]?[0-9]{5}([^0-9]|$)' 'looks like an Indian mobile number'
check '[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z][1-9A-Z]Z[0-9A-Z]' 'looks like a GSTIN'
check 'rzp_(live|test)_[A-Za-z0-9]{8,}' 'looks like a Razorpay key'
check 're_[A-Za-z0-9]{8,}_[A-Za-z0-9]{8,}' 'looks like a Resend API key'
check 'BEGIN [A-Z ]*PRIVATE KEY' 'looks like a private key'

if [ "$fail" = 1 ]; then
  echo "pre-commit: the repo is public. Move it to /admin/settings or an env var, or mark a false" >&2
  echo "            positive with an 'allow-identifier' comment on that line." >&2
  exit 1
fi
