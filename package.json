{
	"name": "aggarwalkart",
	"author": "metalfingerdev",
	"version": "0.8.0",
	"license": "MIT",
	"private": true,
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/aggarwalkart/webapp.git"
	},
	"scripts": {
		"cleanse": "pnpm format && pnpm lint && pnpm check && pnpm test && pnpm build",
		"dev:frontend": "vite dev",
		"dev:backend": "pnpm dlx convex dev",
		"dev": "concurrently --kill-others --prefix-colors \"red,yellow\" --names \"svelte,convex\" \"pnpm dev:frontend\" \"pnpm dev:backend\"",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest run",
		"test": "vitest run",
		"test:e2e": "playwright test"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		],
		"peerDependencyRules": {
			"ignoreMissing": [
				"vite"
			],
			"allowAny": [
				"vite"
			]
		}
	},
	"devDependencies": {
		"@convex-dev/better-auth": "0.12.5",
		"@convex-dev/eslint-plugin": "^2.0.0",
		"@edge-runtime/vm": "^5.0.0",
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "1.64.1",
		"@sveltejs/adapter-vercel": "^7.0.2",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.6",
		"@types/pdfmake": "^0.3.3",
		"@vitest/browser": "^4.1.8",
		"better-auth": "1.6.16",
		"clsx": "^2.1.1",
		"concurrently": "^10.0.3",
		"convex": "^1.49.0",
		"convex-svelte": "^0.15.1",
		"convex-test": "^0.0.66",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"jsdom": "^29.1.1",
		"jsrepo": "^3.8.2",
		"playwright": "^1.61.1",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.5",
		"svelte-eslint-parser": "^1.8.0",
		"svelte-sonner": "^1.2.2",
		"tailwind-merge": "^3.7.0",
		"tailwindcss": "^4.3.0",
		"tsx": "^4.22.4",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.61.0",
		"vite": "^8.3.5",
		"vitest": "^5.1.0",
		"vitest-browser-svelte": "^2.1.1"
	},
	"dependencies": {
		"@better-auth/api-key": "1.6.16",
		"@convex-dev/migrations": "^0.3.7",
		"@convex-dev/rate-limiter": "^0.4.3",
		"@convex-dev/resend": "^0.2.10",
		"@icons-pack/svelte-simple-icons": "^7.2.0",
		"@klinking/squircle": "^0.9.0",
		"@lucide/svelte": "^1.66.0",
		"@mmailaender/convex-better-auth-svelte": "^0.10.0",
		"@zxcvbn-ts/core": "^4.2.0",
		"@zxcvbn-ts/language-common": "^4.1.3",
		"@zxcvbn-ts/language-en": "^4.1.1",
		"bits-ui": "^2.20.4",
		"convex-helpers": "^0.1.133",
		"is-network-error": "^1.3.2",
		"paneforge": "^1.0.2",
		"path-to-regexp": "^8.4.2",
		"pdfmake": "^0.3.11",
		"razorpay": "^2.9.6",
		"runed": "^0.37.1",
		"svelte-easy-crop": "^5.0.1",
		"svelte-toolbelt": "^0.10.6",
		"xlsx": "^0.18.5"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*",
		"#convex/*": "./src/convex/*"
	},
	"packageManager": "pnpm@12.9.0"
}
